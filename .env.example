# DualMind — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Required for Frontier model ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional: for OSS model (HuggingFace) ───────────────────
# Without this, HF free tier is used (rate limited)
HUGGINGFACE_TOKEN=hf_your-token-here

# ── Model selection (optional overrides) ────────────────────
OSS_MODEL=Qwen/Qwen2.5-72B-Instruct
FRONTIER_MODEL=claude-sonnet-4-20250514

# ── Backend server ───────────────────────────────────────────
PORT=8000
